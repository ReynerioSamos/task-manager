<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task List</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Task List</h1>

    <!-- Add Task Form -->
    <form action="/tasks/add-task" method="POST">
        <div>
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" required>
        </div>
        <div>
            <label for="desc">Description:</label>
            <textarea id="desc" name="desc" required></textarea>
        </div>
        <button type="submit">Add Task</button>
    </form>

    <!-- Search by title/desc -->
<form action="/tasks/search" method="GET" class="search-form">
    <input 
        type="text" 
        name="q" 
        placeholder="Search tasks..." 
        value="<%= locals.searchQuery || '' %>"
    >
    <button type="submit">Search</button>
</form>

<!-- Message for search results -->
<% if (locals.searchQuery) { %>
    <p>
        <% if (tasks.length === 0) { %>
            No tasks found matching "<%= searchQuery %>"
        <% } else { %>
            <%= tasks.length %> task(s) found for "<%= searchQuery %>"
        <% } %>
    </p>
<% } %>

    <!-- Filter Tasks Dropdown -->
    <form action="/tasks/filter-tasks" method="GET" class="filter-form">
        <label for="status">Filter by Status:</label>
        <select id="status" name="status">
            <option value="all">All Tasks</option>
            <option value="completed">Completed</option>
            <option value="uncompleted">Uncompleted</option>
        </select>
        <button type="submit">Filter</button>
    </form>

    <!-- Back to All Tasks Link -->
    <a href="/tasks">Back to All Tasks</a>
    
    <!-- Task List -->
    <% if (tasks.length === 0) { %>
        <p>No tasks found. Add a new task above!</p>
    <% } else { %>
        <ul>
            <% tasks.forEach(task => { %>
                <li class="<%= task.completed ? 'completed' : 'incomplete' %>">
                    <span><%= task.title %></span> - <span><%= task.desc %></span>
                    <form action="/tasks/toggle-task/<%= task.id %>" method="POST" style="display:inline;">
                        <input type="hidden" name="id" value="<%= task.id %>">
                        <button type="submit" aria-label="<%= task.completed ? 'Mark Incomplete' : 'Mark Complete' %>">
                            <%= task.completed ? 'Mark Incomplete' : 'Mark Complete' %>
                        </button>
                    </form>
                    <form action="/tasks/delete-task/<%= task.id %>" method="POST" style="display:inline;">
                        <input type="hidden" name="id" value="<%= task.id %>">
                        <button type="submit" aria-label="Delete Task">Delete</button>
                    </form>
                    <form action="/tasks/<%= task.id %>" method="GET" style="display:inline;">
                        <button type="submit" aria-label="View Task">View</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% } %>
</body>
</html>
