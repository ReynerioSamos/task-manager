<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task List</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Task</h1>
            <li>
                <span><%= task.title %></span> - <span><%= task.desc %></span>
                <form action="/tasks/toggle/<%= task.id %>" method="POST" style="display:inline;">
                    <button type="submit"><%= task.completed ? 'Mark Incomplete' : 'Mark Complete' %></button>
                </form>
                <form action="/tasks/delete/<%= task.id %>" method="POST" style="display:inline;">
                    <button type="submit">Delete</button>
                </form>
            </li>
</body>
</html>
